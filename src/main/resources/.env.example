# Server
SERVER_PORT=8080
OPENAPI_SERVER_URL=http://localhost:8080

# Database
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/together_trip
SPRING_DATASOURCE_USERNAME=together_trip
SPRING_DATASOURCE_PASSWORD=together_trip
SPRING_FLYWAY_ENABLED=true
SPRING_FLYWAY_LOCATIONS=classpath:db/migration
JPA_SHOW_SQL=false

# Redis
SPRING_REDIS_HOST=127.0.0.1
SPRING_REDIS_PORT=6379
SPRING_REDIS_PASSWORD=

# JWT
JWT_SECRET=replace-with-at-least-32-byte-secret-key
JWT_ISSUER=together-trip
JWT_ACCESS_TOKEN_EXPIRATION=1800
JWT_REFRESH_TOKEN_EXPIRATION=1209600

# Phone privacy
PHONE_HASH_KEY=replace-with-at-least-32-byte-phone-hash-key
PHONE_HASH_VERSION=v1
PHONE_ENCRYPTION_KEY=replace-with-at-least-32-byte-phone-encryption-key
PHONE_ENCRYPTION_VERSION=v1

# Local auth
AUTH_LOCAL_TEST_ENABLED=false

# SMS
SOLAPI_BASE_URL=https://api.solapi.com
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_FROM=

# API docs
SPRINGDOC_SWAGGER_UI_ENABLED=true
SPRINGDOC_API_DOCS_ENABLED=true

# Upload storage
POST_ATTACHMENT_MAX_FILE_SIZE=10MB
POST_ATTACHMENT_MAX_REQUEST_SIZE=50MB
POST_ATTACHMENT_LOCAL_STORAGE_PATH=./uploads/post-attachments
POST_ATTACHMENT_PUBLIC_URL_PREFIX=/uploads/post-attachments
USER_PROFILE_IMAGE_LOCAL_STORAGE_PATH=./uploads/user-profile-images
USER_PROFILE_IMAGE_PUBLIC_URL_PREFIX=/uploads/user-profile-images
TRIP_RECAP_IMAGE_STORAGE_DIR=./uploads/trip-recaps
TRIP_RECAP_IMAGE_PUBLIC_URL_PREFIX=/uploads/trip-recaps

# Trip
TRIP_INVITE_BASE_URL=http://localhost:8080/trips/invites

# Exchange rate
KOREA_EXIM_EXCHANGE_RATE_BASE_URL=https://oapi.koreaexim.go.kr/site/program/financial/exchangeJSON
KOREA_EXIM_EXCHANGE_RATE_AUTH_KEY=
KOREA_EXIM_EXCHANGE_RATE_DATA_CODE=AP01
KOREA_EXIM_EXCHANGE_RATE_TIMEOUT=10s
EXCHANGE_RATE_IMPORT_MINIMUM_ROW_COUNT=20
EXCHANGE_RATE_IMPORT_REQUIRED_CURRENCIES=USD,JPY,EUR
EXCHANGE_RATE_IMPORT_SKIP_WEEKENDS=true
EXCHANGE_RATE_SCHEDULER_ENABLED=false
EXCHANGE_RATE_SCHEDULER_CRON=0 30 11 * * *
EXCHANGE_RATE_SCHEDULER_CATCH_UP_DAYS=7
EXCHANGE_RATE_BACKFILL_ENABLED=false
EXCHANGE_RATE_BACKFILL_FROM=
EXCHANGE_RATE_BACKFILL_TO=
EXCHANGE_RATE_BACKFILL_PAUSE_BETWEEN_REQUESTS=300ms
EXCHANGE_RATE_LOCK_NAME=exchange-rate:import:korea-exim
EXCHANGE_RATE_LOCK_WAIT_TIME=0s
EXCHANGE_RATE_LOCK_LEASE_TIME=10m

# Notification outbox
NOTIFICATION_SQS_QUEUE_URL=
NOTIFICATION_QUEUE_URL=
NOTIFICATION_SQS_SENDER_ENABLED=true
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
OUTBOX_DISPATCH_ENABLED=true
OUTBOX_DISPATCH_FIXED_DELAY=PT3S
OUTBOX_DISPATCH_LIMIT=50

# Trip Recap AI
# Use "stub" for offline development. Use "openai" only with a server-side API key.
TRIP_RECAP_AI_PROVIDER=stub
OPENAI_BASE_URL=https://api.openai.com
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=1152x2048
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_TIMEOUT=3m
OPENAI_MAX_REFERENCE_IMAGES=4
OPENAI_MAX_REFERENCE_IMAGE_BYTES=10485760
